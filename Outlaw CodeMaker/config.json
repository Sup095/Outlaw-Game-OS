  "ui": {
    "theme": "gold",
    "window_width": 1600,
    "window_height": 1000,
    "font_family": "Segoe UI",
    "mono_family": "Consolas",
    "font_size": 11
  },
  "database": {
    "path": "F:/Outlaw CodeMaker/db/outlaw.db",
    "vault_path": "F:/Outlaw CodeMaker/db/vault.db"
  },
  "godot": {
    "log_path": "F:/Godot Games/the-knight's-quest/project.godot"
  }
