#!/usr/bin/env bash
# ============================================================================
# outlaw-install — guided installer for Outlaw OS
# ----------------------------------------------------------------------------
# SAFETY FIRST. By default it installs into a single EMPTY partition you pick,
# leaving every other partition (Windows, your data, other Linux installs)
# completely untouched. Wiping a whole disk is a separate, clearly-marked
# option that requires you to type the device name AND the word ERASE.
#
# It also supports removing Outlaw OS again ("--uninstall") so you can switch
# back to Windows or another OS without losing other data.
#
# Bootloader: GRUB with os-prober enabled, so your other operating systems are
# detected and added to the boot menu — which is what powers `outlaw-hotswap`.
# ============================================================================
set -uo pipefail

# ESSENTIAL_PKGS — the MINIMUM set needed to (a) boot the installed system,
# (b) bring up the Electron shell + greeter, and (c) run Outlaw CodeMaker.
# Everything else lives in optional bundles that the first-boot wizard
# (/usr/share/outlaw-firstboot) lets the user opt into on first login.
#
# Why split? A failure in any single package causes pacstrap to abort and
# leaves the user with a half-installed system. Keeping the install slim
# shrinks the failure surface and lets users decline things they don't
# want (e.g. gaming users who don't need Godot, devs who don't want Steam).
# steamcmd remains AUR-only — see Outlaw CodeMaker/core/aur_install.py.
ESSENTIAL_PKGS=(
  # Base system
  base linux linux-firmware intel-ucode amd-ucode mkinitcpio
  sudo polkit networkmanager curl wget git nano
  # zram-generator: compressed-RAM swap that outlaw-tune ("Tune This PC")
  # enables on low-memory machines. No effect unless tuning writes its config.
  zram-generator

  # Bootloader / install tooling
  grub efibootmgr os-prober dosfstools mtools gptfdisk parted

  # Security hardening
  apparmor firejail ufw

  # X / desktop runtime
  xorg-server xorg-xinit picom feh rofi thunar xfce4-terminal electron
  # polkit-gnome: authentication agent so `pkexec pacman …` (Apps panel +
  # updater) can prompt for the password. The session has no WM/agent
  # otherwise, which makes package installs fail on the installed system.
  polkit-gnome
  ttf-jetbrains-mono noto-fonts mesa
  # Xorg video fallbacks. Primary path is modesetting over the GPU's KMS
  # driver (vmwgfx / vboxvideo / real GPU); these two are auto-fallbacks Xorg
  # tries if that can't open a screen: vesa (real-mode VESA BIOS) and fbdev
  # (/dev/fb0). No forced driver, no nomodeset. (xf86-video-vmware was dropped
  # from the Arch repos; vmwgfx in-kernel covers VMSVGA.)
  xf86-video-vesa xf86-video-fbdev

  # VirtualBox compatibility. The kernel modules auto-load only when VBox
  # is detected on boot, so this is harmless on real hardware — but for
  # users testing the ISO in VBox / VBox-based VMs, it provides the proper
  # vboxvideo driver and ensures the shell isn't stuck on the fallback
  # framebuffer (which on VBox without 3D is what causes the black-screen
  # symptom). ~10 MB on disk.
  virtualbox-guest-utils

  # Python + build tools (needed for the CodeMaker venv to compile any
  # native pip wheels for pyautogui / pytesseract / pillow on this host)
  python python-pip base-devel cmake

  # Outlaw CodeMaker runtime deps (X11 input + OCR backend for pyautogui /
  # pytesseract). The Python packages themselves live in a venv created in
  # /opt/outlaw-codemaker/.venv during this install (see post-pacstrap step).
  xdotool scrot tesseract tesseract-data-eng
)

# OPTIONAL_BUNDLES — installed by /usr/share/outlaw-firstboot AFTER the user
# logs in for the first time. The wizard shows each bundle as a checkbox
# (defaulting to checked) and lets the user opt out of any of them. Bundle
# definitions inside outlaw-firstboot/main.js must stay in sync with what's
# listed here as a comment for the maintainer's reference:
#
#   steam-gaming: steam, gamemode, lib32-gamemode, gamescope, mangohud,
#                 lib32-mangohud, vulkan-icd-loader, lib32-vulkan-icd-loader,
#                 vulkan-tools, lib32-mesa
#   firefox:      firefox
#   godot:        godot
#
# Anything else (Blender, GIMP, VS Code, Lutris, Wine, etc.) stays available
# on demand via the shell's Apps panel after first login.

PKGS=("${ESSENTIAL_PKGS[@]}")

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }
hr()   { printf '%s\n' "=================================================="; }
die()  { red "ERROR: $*"; exit 1; }

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
is_efi() { [[ -d /sys/firmware/efi/efivars ]]; }

TARGET=/mnt

cleanup() { umount -R "$TARGET" 2>/dev/null || true; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
banner() {
    clear
    hr
    grn "            OUTLAW OS INSTALLER v2.0"
    hr
    if is_efi; then echo "Firmware: UEFI"; else echo "Firmware: BIOS/Legacy"; fi
    echo
}

pick_from_lsblk() {
    # $1 = prompt; echoes the chosen /dev path on stdout
    echo >&2
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS >&2
    echo >&2
    read -rp "$1 (e.g. /dev/sda2, or just sda2): " dev
    # The lsblk list above shows bare kernel names (sda, nvme0n1p2), so users
    # naturally type "sda" — accept that and normalize to a real /dev/ path.
    # (Without this, "sda" fails the block-device check and the installer exits,
    # which — with no window manager — just closes the terminal window.)
    if [[ -n "$dev" && "$dev" != "0" && "$dev" != /dev/* ]]; then
        dev="/dev/$dev"
    fi
    echo "$dev"
}

confirm_word() {
    # $1 = the exact word the user must type
    local typed
    read -rp "Type '$1' to proceed: " typed
    [[ "$typed" == "$1" ]]
}

# ---------------------------------------------------------------------------
do_install() {
    banner
    ylw "Choose an installation strategy:"
    echo
    echo "  1) Install ALONGSIDE other operating systems (recommended)"
    echo "     -> Outlaw goes into a single EMPTY partition you pick."
    echo "     -> Windows / your data / other Linux installs are NOT touched."
    echo "     -> GRUB will add the other OSes to the boot menu automatically."
    echo
    echo "  2) ERASE an entire disk and make Outlaw the only OS (DESTRUCTIVE)"
    echo "     -> Wipes EVERY partition on the chosen disk."
    echo "     -> You will type the device name AND the word ERASE to confirm."
    echo
    echo "  3) Show me my disk layout first (read-only, decide afterwards)"
    echo
    echo "  4) Use FREE / unallocated space on a disk — I'll create the partition"
    echo "     for you (you choose how many GB). Other partitions stay untouched."
    echo
    echo "  0) Back to main menu"
    read -rp "> " strat
    case "$strat" in
        1) install_into_partition ;;
        2) install_wipe_disk ;;
        3) show_disk_layout; return ;;
        4) install_free_space ;;
        *) return ;;
    esac
}

show_disk_layout() {
    banner
    grn "Disk layout (read-only — nothing is being changed)"
    echo
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS
    echo
    ylw "Need to make room for Outlaw without losing other data?"
    echo "  * Inside the live Outlaw system: open a terminal and run \`sudo gparted\`"
    echo "    to shrink an existing partition (e.g. Windows C:) and free up space."
    echo "  * Inside Windows: shrink the C: drive from Disk Management before"
    echo "    booting this USB, then come back here and pick option 1."
    echo
    echo "When you have an empty partition, run \`sudo outlaw-install\` again and pick 1."
}

prepare_common() {
    # Mounts ESP (EFI only) and asks for credentials. Sets globals ESP, USERNAME.
    if is_efi; then
        ylw "Select the EFI System Partition (ESP)."
        echo "On a Windows dual-boot this already exists (FAT32, ~100-500M). It will NOT be formatted."
        ESP="$(pick_from_lsblk 'EFI System Partition')"
        [[ -b "$ESP" ]] || die "Not a block device: $ESP"
        blkid "$ESP" | grep -qi 'TYPE="vfat"' || ylw "Warning: $ESP is not FAT32 — make sure this is really the ESP."
        mkdir -p "$TARGET/boot/efi"
        mount "$ESP" "$TARGET/boot/efi" || die "Could not mount ESP."
    fi
    echo
    read -rp "Username for the operator account: " USERNAME
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username."
}

install_into_partition() {
    banner
    grn "INSTALL ALONGSIDE OTHER OPERATING SYSTEMS"
    echo
    echo "Pick the empty partition you want Outlaw to live in."
    echo
    ylw "Don't see an empty partition?"
    echo "  -> Cancel this (type 0 below), then run \`sudo gparted\` from a terminal"
    echo "     to shrink your Windows / other partition and make room. Come back"
    echo "     here when you have free space + an empty partition."
    echo
    local root
    root="$(pick_from_lsblk 'Target ROOT partition for Outlaw OS (or 0 to cancel)')"
    if [[ "$root" == "0" || -z "$root" ]]; then echo "Cancelled."; return; fi
    [[ -b "$root" ]] || die "Not a block device: $root"

    red "This will FORMAT only $root. Everything currently on $root will be lost."
    ylw "All OTHER partitions and disks stay untouched."
    confirm_word "FORMAT" || { echo "Cancelled."; return; }

    grn "Formatting $root as ext4…"
    mkfs.ext4 -F "$root" || die "mkfs failed."
    mount "$root" "$TARGET" || die "mount failed."

    prepare_common
    pacstrap_and_configure "$root"
}

install_wipe_disk() {
    banner
    red "DESTRUCTIVE MODE — this erases an ENTIRE disk, including any Windows install or data on it."
    local disk
    disk="$(pick_from_lsblk 'Disk to ERASE COMPLETELY')"
    [[ -b "$disk" ]] || die "Not a block device: $disk"
    [[ "$disk" =~ [0-9]$ && "$disk" =~ (sd|vd) ]] && ylw "Note: that looks like a partition, not a whole disk."

    red "You are about to DESTROY ALL DATA on $disk:"
    lsblk "$disk"
    echo
    confirm_word "$disk" || { echo "Device name did not match. Cancelled."; return; }
    red "Final confirmation."
    confirm_word "ERASE" || { echo "Cancelled."; return; }

    grn "Partitioning $disk…"
    if is_efi; then
        sgdisk --zap-all "$disk"
        sgdisk -n1:0:+512M -t1:ef00 -c1:"EFI" "$disk"
        sgdisk -n2:0:0     -t2:8300 -c2:"OutlawRoot" "$disk"
        partprobe "$disk"; sleep 1
        local p1 p2
        p1="$(lsblk -nrpo NAME "$disk" | sed -n 2p)"
        p2="$(lsblk -nrpo NAME "$disk" | sed -n 3p)"
        mkfs.fat -F32 "$p1"
        mkfs.ext4 -F "$p2"
        mount "$p2" "$TARGET"
        mkdir -p "$TARGET/boot/efi"
        ESP="$p1"
        mount "$ESP" "$TARGET/boot/efi"
        read -rp "Username for the operator account: " USERNAME
        [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username."
        pacstrap_and_configure "$p2"
    else
        sgdisk --zap-all "$disk" 2>/dev/null || true
        parted -s "$disk" mklabel msdos
        parted -s "$disk" mkpart primary ext4 1MiB 100%
        parted -s "$disk" set 1 boot on
        partprobe "$disk"; sleep 1
        local p1; p1="$(lsblk -nrpo NAME "$disk" | sed -n 2p)"
        mkfs.ext4 -F "$p1"
        mount "$p1" "$TARGET"
        ESP=""
        read -rp "Username for the operator account: " USERNAME
        [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username."
        BIOS_DISK="$disk"
        pacstrap_and_configure "$p1"
    fi
}

# Install into free/unallocated space, creating the partition automatically at a
# size the user chooses. This is the "I shrank Windows in gparted but the empty
# space doesn't show as a partition" path — free space has no /dev node, so the
# other options (which list partitions) can't see it. We create the partition in
# the largest free region, format ONLY that new partition, and never touch the
# user's existing partitions.
install_free_space() {
    banner
    grn "INSTALL INTO FREE / UNALLOCATED SPACE"
    echo
    echo "I'll create a new partition in the free space on a disk and install"
    echo "Outlaw into it. Your existing partitions are NOT touched or formatted."
    echo
    ylw "No free space yet?"
    echo "  -> Cancel (0), then run \`sudo gparted\`: click the partition you want"
    echo "     to shrink (e.g. Windows C:), choose Resize/Move, drag its RIGHT edge"
    echo "     left to leave 'unallocated' space, click the green Apply ✓, then run"
    echo "     \`sudo outlaw-install\` again and pick this option."
    echo
    local disk
    disk="$(pick_from_lsblk 'Disk that has free space (or 0 to cancel)')"
    if [[ "$disk" == "0" || -z "$disk" ]]; then echo "Cancelled."; return; fi
    [[ -b "$disk" ]] || die "Not a block device: $disk"

    grn "Free space on $disk:"
    echo
    parted -s "$disk" unit GiB print free 2>/dev/null | sed -n '1,40p' || true
    echo

    # Find the largest free region (in MiB) from parted's free-space rows.
    local best_start_mib=0 best_size_mib=0
    while read -r f_start f_end f_size _label; do
        local s="${f_start%MiB}" z="${f_size%MiB}"
        [[ "$s" =~ ^[0-9.]+$ && "$z" =~ ^[0-9.]+$ ]] || continue
        local si="${s%.*}" zi="${z%.*}"
        if (( zi > best_size_mib )); then best_size_mib="$zi"; best_start_mib="$si"; fi
    done < <(parted -s "$disk" unit MiB print free 2>/dev/null | grep -iE 'free space')

    if (( best_size_mib < 8192 )); then
        red "No usable free region found on $disk (need at least ~8 GiB unallocated)."
        echo "Shrink a partition with \`sudo gparted\` first (see above), then retry."
        return
    fi
    local free_gib=$(( best_size_mib / 1024 ))
    grn "Largest free region: about ${free_gib} GiB."
    echo
    local want_gib
    read -rp "How many GiB for Outlaw? [Enter = all ${free_gib}] " want_gib
    [[ -z "$want_gib" ]] && want_gib="$free_gib"
    [[ "$want_gib" =~ ^[0-9]+$ ]] || die "Enter a whole number of GiB."
    (( want_gib >= 8 ))         || die "Outlaw needs at least 8 GiB."
    (( want_gib <= free_gib ))  || die "Only ${free_gib} GiB is free."

    local start_mib="$best_start_mib"
    local end_mib=$(( start_mib + want_gib * 1024 ))

    # EFI needs an EFI System Partition. Reuse an existing one (the normal
    # Windows-dual-boot case) — never create a second. Bail with guidance if
    # we're in EFI mode and the disk has no ESP.
    local esp=""
    if is_efi; then
        esp="$(lsblk -nrpo NAME,PARTTYPE "$disk" 2>/dev/null | awk 'tolower($2)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}')"
    fi

    echo
    red "PLAN — review carefully:"
    echo "   • Create a new ~${want_gib} GiB ext4 partition in the free space on ${disk}."
    echo "   • Existing partitions on ${disk}: left alone (NOT formatted)."
    if is_efi; then
        if [[ -n "$esp" ]]; then
            echo "   • EFI: reuse the existing EFI System Partition ${esp} (mounted, NOT formatted)."
        else
            red "   • EFI mode, but no EFI System Partition exists on ${disk}."
            echo "     To keep your disk safe I won't guess one. Install alongside an OS"
            echo "     that already has an ESP, or create a small FAT32 ESP first."
            return
        fi
    else
        echo "   • BIOS: GRUB will be installed to ${disk} (MBR)."
    fi
    echo
    confirm_word "CREATE" || { echo "Cancelled — nothing was changed."; return; }

    # Snapshot partitions, create the new one, then diff to find it — robust
    # across sd*/nvme* naming and partition numbering.
    local before after newpart
    before="$(lsblk -nrpo NAME "$disk" | tail -n +2 | sort)"
    grn "Creating the partition…"
    parted -a optimal -s "$disk" mkpart primary ext4 "${start_mib}MiB" "${end_mib}MiB" \
        || die "parted couldn't create the partition (is the partition table full?)."
    partprobe "$disk" 2>/dev/null || true
    sleep 1
    after="$(lsblk -nrpo NAME "$disk" | tail -n +2 | sort)"
    newpart="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -n1)"
    if [[ -z "$newpart" || ! -b "$newpart" ]]; then
        partprobe "$disk" 2>/dev/null || true; sleep 1
        after="$(lsblk -nrpo NAME "$disk" | tail -n +2 | sort)"
        newpart="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -n1)"
    fi
    [[ -n "$newpart" && -b "$newpart" ]] || die "Couldn't find the new partition. Check \`lsblk\` and use option 1 to point at it directly."

    grn "Formatting $newpart as ext4…"
    mkfs.ext4 -F "$newpart" || die "mkfs failed on $newpart."
    mount "$newpart" "$TARGET" || die "mount failed."

    if is_efi; then
        mkdir -p "$TARGET/boot/efi"
        mount "$esp" "$TARGET/boot/efi" || die "Couldn't mount the ESP $esp."
        ESP="$esp"
    else
        ESP=""
        BIOS_DISK="$disk"
    fi
    read -rp "Username for the operator account: " USERNAME
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username."
    pacstrap_and_configure "$newpart"
}

# Make sure pacstrap will actually be able to download packages. The slim live
# ISO ships a small default mirrorlist (Arch global CDN first) but no reflector,
# so we guarantee a usable mirror, init the keyring if empty, check we're online,
# and refresh the databases — turning the old silent "pacstrap failed (check
# your mirrors)" into a clear, early, fixable message.
prepare_network_and_mirrors() {
    local ML=/etc/pacman.d/mirrorlist
    grn "Preparing package mirrors…"
    # Guarantee at least one active Server line (a stock all-commented mirrorlist
    # is the #1 cause of "could not connect to server").
    if ! grep -qE '^[[:space:]]*Server[[:space:]]*=' "$ML" 2>/dev/null; then
        ylw "No active mirror found — adding the Arch global CDN."
        { echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch'
          cat "$ML" 2>/dev/null; } > "$ML.outlaw" && mv "$ML.outlaw" "$ML"
    fi
    # Initialise signing keys on the live system if the keyring is empty.
    if [[ ! -s /etc/pacman.d/gnupg/pubring.gpg ]]; then
        ylw "Initialising package-signing keys…"
        pacman-key --init >/dev/null 2>&1 || true
        pacman-key --populate archlinux >/dev/null 2>&1 || true
    fi
    # Fail EARLY (with guidance) if there's no internet, instead of deep in pacstrap.
    if ! curl -fsS --max-time 15 -o /dev/null "https://geo.mirror.pkgbuild.com/lastsync" 2>/dev/null; then
        ylw "WARNING: couldn't reach the Arch package servers."
        echo "  Installing needs an internet connection."
        echo "  Connect now with:  nmtui   (choose Wi-Fi or Ethernet), confirm you"
        echo "  can reach the internet, then continue."
        confirm_word "CONTINUE" || die "No network — cancelled. Connect, then re-run: sudo outlaw-install"
    fi
    grn "Refreshing package databases…"
    pacman -Syy --noconfirm >/dev/null 2>&1 || pacman -Syy --noconfirm || \
        ylw "Database refresh hit a snag — pacstrap will retry mirrors as it installs."
}

pacstrap_and_configure() {
    local rootdev="$1"
    prepare_network_and_mirrors
    grn "Installing base system (this can take a while)…"
    if ! pacstrap -K "$TARGET" "${PKGS[@]}"; then
        red "pacstrap failed — the base system did not install."
        echo "  Almost always this is a network / mirror problem:"
        echo "   • Connect to the internet:   nmtui   (Wi-Fi or Ethernet)"
        echo "   • Then run again:            sudo outlaw-install"
        echo "  The Arch global CDN is already first in /etc/pacman.d/mirrorlist,"
        echo "  so a single slow mirror shouldn't stop you — just retry."
        die "Install aborted."
    fi

    genfstab -U "$TARGET" >> "$TARGET/etc/fstab"

    # Carry our working mirrorlist into the installed system. pacstrap installs a
    # fresh `pacman-mirrorlist` whose /etc/pacman.d/mirrorlist is ALL COMMENTED,
    # so without this the installed system's pacman (Apps panel, updates) would
    # fail to connect just like the live ISO did before this fix.
    if [[ -s /etc/pacman.d/mirrorlist ]]; then
        cp -f /etc/pacman.d/mirrorlist "$TARGET/etc/pacman.d/mirrorlist" 2>/dev/null || true
    fi

    # Bring the shell + helper tools into the installed system.
    mkdir -p "$TARGET/usr/share/outlaw-os"
    cp -rT /usr/share/outlaw-os "$TARGET/usr/share/outlaw-os" 2>/dev/null || true
    rm -rf "$TARGET/usr/share/outlaw-os/node_modules" 2>/dev/null || true

    # Greeter Electron app + Outlaw CodeMaker bundle (both baked into the live
    # ISO by build.sh). Either may be absent if the build skipped them; the
    # launcher scripts handle missing-bundle gracefully.
    if [[ -d /usr/share/outlaw-greeter ]]; then
        mkdir -p "$TARGET/usr/share/outlaw-greeter"
        cp -rT /usr/share/outlaw-greeter "$TARGET/usr/share/outlaw-greeter"
    fi
    if [[ -d /opt/outlaw-codemaker ]]; then
        mkdir -p "$TARGET/opt/outlaw-codemaker"
        cp -rT /opt/outlaw-codemaker "$TARGET/opt/outlaw-codemaker"
    fi

    # Copy EVERY outlaw-* helper from the live image into the installed system.
    # Using a glob (not a hardcoded list) means new helpers added to the ISO —
    # outlaw-electron-flags, outlaw-firstboot, outlaw-start-session,
    # outlaw-install-aur, etc. — are picked up automatically. A stale hardcoded
    # list here previously dropped the VM GPU-flag helper from installs, which
    # left the installed system black-screening even after the live ISO worked.
    shopt -s nullglob
    for helper in /usr/local/bin/outlaw-*; do
        [[ -f "$helper" ]] || continue
        install -Dm755 "$helper" "$TARGET/usr/local/bin/$(basename "$helper")"
    done
    shopt -u nullglob

    # First-boot wizard Electron app (separate from the shell). Copy if the
    # live image carries it.
    if [[ -d /usr/share/outlaw-firstboot ]]; then
        mkdir -p "$TARGET/usr/share/outlaw-firstboot"
        cp -rT /usr/share/outlaw-firstboot "$TARGET/usr/share/outlaw-firstboot"
        rm -rf "$TARGET/usr/share/outlaw-firstboot/node_modules" 2>/dev/null || true
    fi

    # Propagate /etc/skel from the live system so new accounts inherit Outlaw's
    # .bash_profile + .xinitrc (boot routing) and ~/.config/systemd/user/
    # (SC4 scheduled diagnostic timers, disabled by default). pacstrap pulls in
    # an Arch-base /etc/skel that lacks all of these; we layer our overrides on
    # top, preserving any base files we don't override.
    if [[ -d /etc/skel ]]; then
        mkdir -p "$TARGET/etc/skel"
        cp -rT /etc/skel "$TARGET/etc/skel" 2>/dev/null || true
    fi

    # Ask for the password here so it is passed into the chroot securely.
    local pw1 pw2
    while :; do
        read -rsp "Password for $USERNAME (and disk): " pw1; echo
        read -rsp "Confirm password: " pw2; echo
        [[ "$pw1" == "$pw2" && -n "$pw1" ]] && break
        red "Passwords did not match (or were empty). Try again."
    done

    # For BIOS, GRUB is written to the parent disk's MBR (never a partition).
    local BOOT_TARGET="${BIOS_DISK:-}"
    if [[ -z "$BOOT_TARGET" ]]; then
        BOOT_TARGET="/dev/$(lsblk -nro PKNAME "$rootdev" | head -n1)"
    fi

    grn "Configuring the installed system…"
    cat > "$TARGET/root/outlaw-chroot.sh" <<CHROOT
#!/usr/bin/env bash
set -e
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc || true
sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen
echo 'LANG=en_US.UTF-8' > /etc/locale.conf
echo 'outlaw' > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   outlaw.localdomain outlaw
HOSTS

# Operator account (member of wheel; sudo requires the password — no NOPASSWD).
useradd -m -G wheel,video,audio,input,storage,network -s /bin/bash "$USERNAME"
install -d /etc/sudoers.d
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
# Let the operator manage ONLY the local AI service + perf governor without a prompt loop.
chmod 440 /etc/sudoers.d/10-wheel

# Autologin the operator on tty1 (their .bash_profile then starts the shell).
install -d /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<GETTY
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin $USERNAME --noclear %I 38400 linux
GETTY

systemctl enable NetworkManager apparmor
# AI is provided by LM Studio (a user-installed desktop app, not a systemd
# service). The shell talks to it on 127.0.0.1:1234 only when the user toggles
# the AI on. Nothing to enable/disable here.

# GRUB with OTHER-OS detection enabled (powers dual boot + hotswap).
sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
grep -q GRUB_DISABLE_OS_PROBER /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
sed -i 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT=saved/' /etc/default/grub
grep -q '^GRUB_SAVEDEFAULT' /etc/default/grub || echo 'GRUB_SAVEDEFAULT=true' >> /etc/default/grub

if [[ -d /sys/firmware/efi/efivars ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=OutlawOS --recheck
else
    grub-install --target=i386-pc --recheck "$BOOT_TARGET"
fi
grub-mkconfig -o /boot/grub/grub.cfg
mkinitcpio -P

# --- Outlaw CodeMaker venv (Dev session runtime) ---------------------------
# CodeMaker source was copied to /opt/outlaw-codemaker before the chroot. If
# the bundle is present we create a venv and install its pinned Linux deps so
# the launcher (/usr/local/bin/outlaw-codemaker) finds .venv/bin/python on the
# first Dev session and starts cleanly. Skip on failure — the launcher's
# fallback opens the desktop shell with a notification.
if [[ -f /opt/outlaw-codemaker/main.py ]]; then
    REQS=/opt/outlaw-codemaker/requirements-linux.txt
    [[ -f "$REQS" ]] || REQS=/opt/outlaw-codemaker/requirements.txt
    if [[ -f "$REQS" ]]; then
        echo "Provisioning Outlaw CodeMaker venv at /opt/outlaw-codemaker/.venv (this may take a few minutes)…"
        python -m venv /opt/outlaw-codemaker/.venv || true
        /opt/outlaw-codemaker/.venv/bin/pip install --upgrade pip || true
        # --no-cache-dir keeps the on-disk footprint smaller; some wheels are big.
        /opt/outlaw-codemaker/.venv/bin/pip install --no-cache-dir -r "$REQS" \
            || echo "WARNING: some Outlaw CodeMaker dependencies failed to install — Dev session may degrade."
    fi
fi
CHROOT

    # Display: the installed system uses the standard kernel mode-setting path
    # (modesetting Xorg driver over vmwgfx / vboxvideo / a real GPU), with
    # xf86-video-vesa and -fbdev installed as automatic fallbacks. We do NOT
    # force `nomodeset` or the fbdev driver here: that was a workaround for a
    # black screen we later traced to the live root shell (now fixed), and it
    # actually broke X in BIOS mode ("no screens found", no framebuffer).

    chmod +x "$TARGET/root/outlaw-chroot.sh"
    arch-chroot "$TARGET" /root/outlaw-chroot.sh || die "Configuration failed."
    rm -f "$TARGET/root/outlaw-chroot.sh"

    # Set passwords via stdin so they are never written to a file or argv.
    printf '%s:%s\n' "$USERNAME" "$pw1" | arch-chroot "$TARGET" chpasswd
    printf 'root:%s\n' "$pw1"           | arch-chroot "$TARGET" chpasswd
    unset pw1 pw2

    echo
    grn "✅ Outlaw OS installed successfully."
    echo "Remove the USB and reboot. Your other operating systems remain in the boot menu."
    echo "Switch between them any time with the HOTSWAP button or 'outlaw-hotswap'."
}

# ---------------------------------------------------------------------------
do_uninstall() {
    banner
    ylw "Remove Outlaw OS — your other operating systems and their data stay intact."
    echo
    if is_efi && command -v efibootmgr >/dev/null; then
        echo "Current UEFI boot entries:"
        efibootmgr | grep -Ei 'outlaw' || echo "  (no Outlaw entry found)"
        echo
        read -rp "Remove the OutlawOS UEFI boot entry? [y/N] " a
        if [[ "$a" =~ ^[Yy]$ ]]; then
            for n in $(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\?.*[Oo]utlaw.*/\1/p'); do
                efibootmgr -b "$n" -B && grn "Removed Boot$n."
            done
        fi
    fi
    echo
    ylw "Optionally free the partition Outlaw OS lived on (this erases ONLY that partition)."
    read -rp "Format an Outlaw partition now? [y/N] " a
    if [[ "$a" =~ ^[Yy]$ ]]; then
        local p; p="$(pick_from_lsblk 'Outlaw OS root partition to free')"
        [[ -b "$p" ]] || die "Not a block device: $p"
        red "This formats ONLY $p. Other partitions are untouched."
        confirm_word "FORMAT" || { echo "Cancelled."; return; }
        mkfs.ext4 -F "$p" && grn "Freed $p."
    fi
    grn "Done. Reboot and your other OS will start as normal."
    ylw "Tip: in Windows you can reclaim the freed space with Disk Management."
}

# ---------------------------------------------------------------------------
banner
case "${1:-}" in
    --uninstall) do_uninstall; exit 0 ;;
esac

while :; do
    banner
    grn "Welcome to the Outlaw OS installer."
    echo "You're running the live system — nothing is installed yet."
    echo
    echo "  1) Install Outlaw OS  (alongside other OSes OR wipe a whole disk)"
    echo "  2) Show my disk layout (read-only)"
    echo "  3) Remove Outlaw OS  (switch back to another OS)"
    echo "  4) Open a shell"
    echo "  0) Reboot"
    echo
    ylw "Tip: need to make space first? Run \`sudo gparted\` from a terminal."
    echo
    read -rp "> " main
    case "$main" in
        1) do_install ;;
        2) show_disk_layout ;;
        3) do_uninstall ;;
        4) bash ;;
        0) systemctl reboot ;;
        *) ;;
    esac
    echo; read -rp "Press Enter to return to the menu…" _
done
