#!/bin/bash
# ============================================================================
# outlaw-session-watchdog — crash-loop guard for the X session.
# ----------------------------------------------------------------------------
# Wraps the actual session launcher (outlaw-codemaker, electron, etc.) and
# tracks consecutive quick deaths. If a session crashes 3 times in a row
# without ever running long enough to be considered "healthy", we force the
# next boot into Desktop session and drop a marker file the shell reads to
# show a "Safe mode — last session crashed repeatedly" banner.
#
# Usage:
#   outlaw-session-watchdog <session-name> <command> [args...]
#
# Where <session-name> is one of: dev, desktop, tty.
#
# State files (in $HOME):
#   .outlaw-session-fails   JSON: {"fails": N, "session": "dev|desktop"}
#   .outlaw-safe-mode       Marker present iff we just forced a fallback.
#                           Contains a one-line human reason. Shell reads it
#                           on boot, displays a banner, then deletes it.
#
# A session is "healthy" if it ran for at least HEALTHY_SECONDS. Manual quit
# under that threshold is treated as a crash from the watchdog's POV — false
# positive, but a single fast quit followed by a normal session resets the
# counter cleanly, so it self-heals.
# ============================================================================

set -u

MAX_FAILS=3
HEALTHY_SECONDS=60
SAFE_FALLBACK=desktop  # what we force after MAX_FAILS consecutive crashes

STATE="$HOME/.outlaw-session-fails"
SAFE_MARKER="$HOME/.outlaw-safe-mode"
SESSION_FILE="$HOME/.outlaw-session"

if [[ $# -lt 2 ]]; then
    echo "usage: $0 <session-name> <command> [args...]" >&2
    exit 2
fi
SESSION_NAME="$1"
shift
COMMAND=("$@")

# ----- tiny JSON read helpers (no jq dependency) ----------------------------
_state_read_int() {
    local key="$1"
    [[ -f "$STATE" ]] || { echo 0; return; }
    # Grep for "key": NUMBER  — tolerant of extra whitespace.
    local val
    val=$(grep -oE "\"$key\"\s*:\s*[0-9]+" "$STATE" 2>/dev/null | tail -n1 \
        | grep -oE '[0-9]+$' | tail -n1)
    echo "${val:-0}"
}
_state_read_str() {
    local key="$1"
    [[ -f "$STATE" ]] || { echo ""; return; }
    local val
    val=$(grep -oE "\"$key\"\s*:\s*\"[^\"]*\"" "$STATE" 2>/dev/null | tail -n1 \
        | sed -E 's/.*"([^"]*)"$/\1/')
    echo "$val"
}
_state_write() {
    local fails="$1" sess="$2"
    cat > "$STATE" <<EOF
{
  "fails": ${fails},
  "session": "${sess}"
}
EOF
}

FAILS=$(_state_read_int fails)
PRIOR_SESSION=$(_state_read_str session)

# ----- check if we should force the fallback --------------------------------
if [[ "$FAILS" -ge "$MAX_FAILS" && "$PRIOR_SESSION" == "$SESSION_NAME" ]]; then
    # Three or more consecutive failures of THIS session. Force the safe one.
    if [[ "$SESSION_NAME" == "$SAFE_FALLBACK" ]]; then
        # The desktop itself is crashing — last resort: drop to TTY. The
        # safe-mode marker still tells the user what happened.
        echo "$(date -Iseconds): desktop session crash-looping ($FAILS fails) — dropping to TTY." > "$SAFE_MARKER"
        echo "tty" > "$SESSION_FILE"
        exit 0  # .xinitrc reads $SESSION_FILE and exits X
    fi
    echo "$(date -Iseconds): $SESSION_NAME crashed $FAILS times in a row — forcing $SAFE_FALLBACK." > "$SAFE_MARKER"
    echo "$SAFE_FALLBACK" > "$SESSION_FILE"
    # Reset counter to 0 since we're switching sessions — give the fallback a
    # clean slate. (If desktop itself starts crashing, the next pass through
    # the watchdog will start counting fresh against "desktop".)
    _state_write 0 "$SAFE_FALLBACK"
    echo "outlaw-session-watchdog: $SESSION_NAME crash-looping. Forced $SAFE_FALLBACK." >&2
    # Tell .xinitrc to re-read the session file and pick the fallback. Exit
    # non-zero so the caller knows we didn't run the requested command.
    exit 87
fi

# ----- run the session with a start timestamp -------------------------------
# Track this attempt as pending — if the command runs long enough we'll clear
# it back to 0 on success.
PENDING=$((FAILS + 1))
_state_write "$PENDING" "$SESSION_NAME"

START_TS=$(date +%s)
"${COMMAND[@]}"
RC=$?
END_TS=$(date +%s)
RAN_FOR=$((END_TS - START_TS))

# ----- decide if this attempt was "healthy" ---------------------------------
if [[ "$RAN_FOR" -ge "$HEALTHY_SECONDS" ]]; then
    # Long enough — the user actually used the session. Clear the counter.
    _state_write 0 "$SESSION_NAME"
fi
# Otherwise leave the counter at PENDING — the next attempt of the same session
# will bump it; three in a row triggers the fallback above.

exit "$RC"
