{
  "name": "outlaw-os",
  "version": "2.0.0",
  "description": "Outlaw OS - lightweight, secure Linux desktop for AI-driven Godot game development with LM Studio + Steam",
  "main": "main.js",
  "author": "Outlaw OS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron": "^41.2.1"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.outlaw.os",
    "files": [
      "main.js",
      "preload.js",
      "ai-agent.js",
      "renderer.js",
      "syscore.js",
      "diagnostics.js",
      "diagnostics-cli.js",
      "tts.js",
      "dialogue.js",
      "dialogue.json",
      "vram-tier.js",
      "coreai.js",
      "index.html",
      "styles.css"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "System"
    }
  }
}
